{
  "name": "tessembly",
  "version": "0.2.0",
  "description": "Zero-dependency Tetris supply formats, constraints and binary interchange powered by Rust/WebAssembly.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daejunnom/Tessembly.git",
    "directory": "packages/npm"
  },
  "homepage": "https://daejunnom.github.io/Tessembly/",
  "keywords": [
    "tetris",
    "queue",
    "pattern",
    "wasm",
    "tessembly"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./browser.js",
      "node": "./node.js",
      "default": "./browser.js"
    },
    "./browser": {
      "types": "./index.d.ts",
      "default": "./browser.js"
    },
    "./locale": {
      "types": "./locale.d.ts",
      "default": "./locale.js"
    },
    "./tessembly.wasm": "./tessembly.wasm"
  },
  "types": "./index.d.ts",
  "bin": {
    "tessembly": "./bin/tessembly.js"
  },
  "files": [
    "*.js",
    "*.d.ts",
    "tessembly.wasm",
    "bin",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
