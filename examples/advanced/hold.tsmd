tessembly "tessembly.rfc2.precedence.v1";
config {
    rule = from_source;
    start = boundary();
    see = view(next=5);
    hold = slot(initial=token("T", origin=9), used=false, allowed=true, deny=["I"]);
    active = token("I", origin=10);
    queue = [token("O", origin=11)];
    cursor = 0;
    tail = end;
}
supply("IO");
