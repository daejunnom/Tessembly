@@ -0,0 +1,115 @@
+//! Optional external-integrator F1/F2 suite. No product parser or evaluator dependency.
+#![forbid(unsafe_code)]
+use serde_json::{json,Value};
+use std::{collections::BTreeSet,time::Duration};
+const PROFILE:&str="tessembly.rfc3.order.v1";
+const PROTOCOL:&str="tessembly.test-port.v1";
+struct Runner {command:Vec<String>,results:Vec<Value>,aborted:bool}
+impl Runner {
+    fn test(&mut self,name:&str,mut request:Value,check:impl FnOnce(&Value)->bool)->Option<Value> {
+        if self.aborted {return None;}
+        let id=self.results.len();
+        request["id"]=json!(id);request["protocol"]=json!(PROTOCOL);request["profile"]=json!(PROFILE);
+        let response=tessembly_conformance::exchange(&self.command,format!("{request}\n").into_bytes(),Duration::from_secs(10))
+            .and_then(|b|serde_json::from_slice::<Value>(&b).map_err(|e|e.to_string()));
+        let (pass,detail)=match &response {
+            Ok(v)=>(v["id"]==id && v["protocol"]==PROTOCOL && v["profile"]==PROFILE && check(v),
+                json!(tessembly_conformance::response_preview(v))),
+            Err(e)=>{self.aborted=true;(false,json!(e))}
+        };
+        eprintln!("{} {name}",if pass {"PASS"} else {"FAIL"});
+        self.results.push(json!({"name":name,"passed":pass,"detail":if pass {Value::Null} else {detail}}));
+        response.ok()
+    }
+    fn queues(&mut self,text:&str,expected:BTreeSet<String>) {
+        self.test(text,json!({"op":"enumerate_D","text":text}),|v| {
+            let Some(xs)=v["queues"].as_array() else {return false;};
+            let actual:BTreeSet<_>=xs.iter().filter_map(|v|v.as_str().map(str::to_string)).collect();
+            v["status"]=="OK" && v["complete"]==true && actual.len()==xs.len()
+                && v["count"]==xs.len() && actual==expected
+        });
+    }
+}
+fn permutations(n:usize)->Vec<String> {
+    fn walk(q:&mut String,n:usize,out:&mut Vec<String>) {
+        if q.len()==n {out.push(q.clone());return;}
+        for c in ['I','O','T','S','Z','J','L'] {if !q.contains(c) {q.push(c);walk(q,n,out);q.pop();}}
+    }
+    let mut out=Vec::new();walk(&mut String::new(),n,&mut out);out
+}
+fn before(q:&str,a:char,b:char)->bool {
+    a!=b && q.chars().find(|c|*c==a||*c==b)==Some(a)
+}
+fn run(r:&mut Runner) {
+    r.test("explicit optional extension capabilities",json!({"op":"capabilities"}),|v| {
+        ["filters.logic.v1","filters.count.v1","filters.window.v1","filters.occurrence.v1"].iter()
+            .all(|s|v["filter_capabilities"].as_array().is_some_and(|xs|xs.contains(&json!(s))))
+    });
+    let p=permutations(4);
+    type Case=(&'static str,fn(&str)->bool);
+    let cases:&[Case]=&[
+        ("P4:D(I<T&T)",|q|before(q,'I','T')&&q.contains('T')),
+        ("P4:D(I<T|S<Z)",|q|before(q,'I','T')||before(q,'S','Z')),
+        ("P4:D(!T)",|q|!q.contains('T')),
+        ("P4:D(!(I<T))",|q|!before(q,'I','T')),
+        ("P4:D(I|T&S)",|q|q.contains('I')||(q.contains('T')&&q.contains('S'))),
+        ("P4:D(I|T,S)",|q|(q.contains('I')||q.contains('T'))&&q.contains('S')),
+        ("P4:D(T=1&S=0)",|q|q.contains('T')&&!q.contains('S')),
+        ("P4:D(T!=0)",|q|q.contains('T')),
+        ("P4:D(T<=0)",|q|!q.contains('T')),
+        ("P4:D(T>=1)",|q|q.contains('T')),
+        ("P4:D(T>0)",|q|q.contains('T')),
+        ("P4:D(T<1)",|q|!q.contains('T')),
+        ("P4:D(IN(1,3,T))",|q|q[..3].contains('T')),
+        ("P4:D(IN(2,2,T))",|q|&q[1..2]=="T"),
+        ("P4:D(IN(2,4,I<T))",|q|before(&q[1..4],'I','T')),
+        ("P4:D(IN(1,2,I|T)&IN(3,4,!S))",|q|(q[..2].contains('I')||q[..2].contains('T'))&&!q[2..].contains('S')),
+    ];
+    for (pattern,accept) in cases {r.queues(pattern,p.iter().filter(|s|accept(s)).cloned().collect());}
+    for (pattern,queues) in [
+        ("{ITIT}:D(I[2]<T[2])",vec!["ITIT"]),
+        ("{TITI}:D(I[2]<T[2])",vec![]),
+        ("{ITI}:D(I[2]<T[2])",vec!["ITI"]),
+        ("{ITI}:D(I[2]<T[2],T[2])",vec![]),
+        ("{TITI}:D(IN(2,4,I[2]))",vec!["TITI"]),
+        ("I{TIS}:D(IN(1,1,T))",vec!["ITIS"]),
+        ("{OSZJ}:D(!(I<T))",vec!["OSZJ"]),
+        ("{OSZJ}:D(T<I)",vec![]),
+        ("{IT}:D((I<T&T<I)|I)",vec!["IT"]),
+    ] {r.queues(pattern,queues.into_iter().map(str::to_string).collect());}
+    for (pattern,unsat) in [
+        ("P7:D((I<T&T<I)|T)",false),
+        ("P7:D((I<T<T)|(T<I<T))",true),
+        ("P7:D(!(I<T)&T<I)",false),
+        ("P7:D(I<T&O<I&T<O)",true),
+        ("{P7P7}:D(I[2]<T[2]<I[2])",true),
+        ("P7:D(IN(1,3,I<T)&IN(4,7,T<I))",false),
+    ] {r.test(pattern,json!({"op":"compile","text":pattern}),|v|v["status"]=="OK" && (v["draw_feasibility"]=="UNSAT")==unsat);}
+    for pattern in ["P4:D(T|IN(1,5,I))","P4:D(IN(0,3,T))","P4:D(T[0])",
+        "P4:D(T==1)","P4:D(T&&I)","P4:D(T||I)","P4:D(!I<T)","P4:D(TS=1)"] {
+        r.test(pattern,json!({"op":"compile","text":pattern}),|v|v["complete"]==false && v["status"]=="INVALID_SYNTAX");
+    }
+    r.test("F2 usage selector not silently reassigned",json!({"op":"compile","text":"P4:U(IN(1,3,T))"}),|v|v["status"]=="UNSUPPORTED");
+    r.test("U boolean witness without physical legality claim",json!({"op":"evaluate_U_witness","text":"{IT}:U(T<I&!S)","queue":"IT","order":[1,0],"closed":true}),|v|v["matches"]==true && v["legality_checked"]==false);
+    let text="P7:D(IN(1,3,T=1)|!(I<T))";
+    if let Some(v)=r.test("structural filter encode",json!({"op":"encode","text":text}),|v|v["status"]=="OK") {
+        if let Some(hex)=v["hex"].as_str() {
+            r.test("structural filter decode preserves bytes",json!({"op":"decode","hex":hex}),|v|v["status"]=="OK"&&v["reencoded_hex"]==hex);
+        }
+    }
+    r.test("work exhaustion is not empty success",json!({"op":"enumerate_D","text":"P7:D(I<T|S)","budget":5}),|v|v["status"]=="INCOMPLETE"&&v.get("count").is_none());
+}
+fn main() {
+    let args:Vec<_>=std::env::args().skip(1).collect();let mut at=0;let mut report=None;
+    if args.first().is_some_and(|s|s=="--report") {report=args.get(1).cloned();at=2;}
+    if args.get(at).is_some_and(|s|s=="--") {at+=1;}
+    if at>=args.len() {eprintln!("tessembly-filter-tck [--report FILE] -- TRUSTED_HOST [ARGS...]");std::process::exit(2);}
+    let mut r=Runner{command:args[at..].to_vec(),results:vec![],aborted:false};run(&mut r);
+    let passed=r.results.iter().filter(|v|v["passed"]==true).count();
+    let out=json!({"profile":PROFILE,"scope":"optional external-integrator F1/F2 contracts; not a solver or certification", "passed":passed,"total":r.results.len(),"complete":!r.aborted,"results":r.results});
+    if let Some(path)=report {
+        let bytes=serde_json::to_vec_pretty(&out).expect("JSON output");
+        if let Err(e)=std::fs::write(path,bytes) {eprintln!("{e}");std::process::exit(2);}
+    } else {println!("{out}");}
+    if passed!=r.results.len() || r.aborted {std::process::exit(1);}
+}
