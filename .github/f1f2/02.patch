+use tessembly_core::{pieces, CountOp, Filter, Occurrence, Piece, Predicate, PredicateKind,
+    Span, PROFILE, LEGACY_PROFILE};
+use tessembly_relations::{analyze, matches_checked, evaluate_filter_checked};
+fn filter(text:&str)->tessembly_core::Node {tessembly_text::parse(text,PROFILE).unwrap()}
+fn accepts(condition:&str,q:&str)->bool {
+    let n=filter(&format!("{{{q}}}:D({condition})"));
+    matches_checked(&pieces(q).unwrap(),n.constraints.draw.as_ref().unwrap()).unwrap()
+}
+#[test]
+fn logical_truth_tables_and_missing_kinds() {
+    for q in ["I","T","S","IT","TS","IS","ITS","OSZJ"] {
+        let i=q.contains('I');let t=q.contains('T');let s=q.contains('S');
+        assert_eq!(accepts("I&T",q),i&&t,"{q}");
+        assert_eq!(accepts("I|T",q),i||t,"{q}");
+        assert_eq!(accepts("!I",q),!i,"{q}");
+        assert_eq!(accepts("I|T&S",q),i||(t&&s),"{q}");
+        assert_eq!(accepts("I|T,S",q),(i||t)&&s,"{q}");
+        assert_eq!(accepts("(I|T)&S",q),(i||t)&&s,"{q}");
+    }
+    assert!(accepts("!(I<T)","OSZJ"));
+    assert!(!accepts("T<I","OSZJ"));
+}
+#[test]
+fn count_operators_have_no_assignment_or_group_total() {
+    for q in ["I","T","TT","TIT","TTTI"] {
+        let n=q.bytes().filter(|c|*c==b'T').count();
+        for (op,expected) in [("=",n==2),("!=",n!=2),("<",n<2),("<=",n<=2),(">",n>2),(">=",n>=2)] {
+            assert_eq!(accepts(&format!("T{op}2"),q),expected,"{op} {q}");
+        }
+    }
+    for bad in ["P4:D(TS=1)","P4:D(T==1)","P4:D(T+=1)","P4:D(T=1=1)"] {
+        assert!(tessembly_text::parse(bad,PROFILE).is_err(),"{bad}");
+    }
+}
+#[test]
+fn inclusive_windows_preserve_the_supply_scope() {
+    assert!(accepts("IN(1,3,T)","ITOSZJL"));
+    assert!(!accepts("IN(1,1,T)","ITOSZJL"));
+    assert!(accepts("IN(2,2,T)","ITOSZJL"));
+    assert!(accepts("IN(3,7,I<T)","TIITSZO"));
+    assert!(accepts("IN(1,3,T)&IN(4,7,J)","ITOSZJL"));
+    assert!(!accepts("IN(1,3,T)&IN(4,7,I)","ITOSZJL"));
+    assert_eq!(filter("P7:D(IN(1,3,T))").validate().unwrap(),7);
+}
+#[test]
+fn invalid_windows_are_checked_even_when_short_circuited() {
+    for bad in ["P4:D(T|IN(1,5,I))","P4:D(!T&IN(0,2,I))","P4:D(IN(3,2,T))",
+        "P4:D(IN(1,3,IN(1,4,T)))","P4:D(IN(1,257,T))"] {
+        assert!(tessembly_text::parse(bad,PROFILE).is_err(),"{bad}");
+    }
+}
+#[test]
+fn ordinals_are_local_occurrences_not_token_ids() {
+    assert!(accepts("I[2]<T[2]","ITIT"));
+    assert!(!accepts("I[2]<T[2]","TITI"));
+    assert!(accepts("I[2]<T[2]","ITI"));
+    assert!(!accepts("I[2]<T[2]","TI"));
+    assert!(!accepts("I[2]<T[2],T[2]","ITI"));
+    assert!(!accepts("IN(2,4,I[2])","ITIT"));
+    assert!(accepts("IN(2,4,I[2])","TITI"));
+    assert!(accepts("II<T","ITI"));
+    assert!(!accepts("I[2]<T","ITI"));
+    for q in ["I","T","IT","TI","ITIT"] {assert_eq!(accepts("I<T",q),accepts("I[1]<T[1]",q));}
+}
+#[test]
+fn group_chains_keep_adjacent_cross_products_inside_boolean_expressions() {
+    for q in ["ITS","IST","TIS","TSI","SIT","STI","I","T","S"] {
+        assert_eq!(accepts("I<T>S",q),accepts("T>IS",q));
+        assert_eq!(accepts("I<T<S",q),accepts("I<T&T<S",q));
+        assert_eq!(accepts("!(I<T>S)",q),!accepts("T>IS",q));
+    }
+}
+#[test]
+fn static_proofs_do_not_leak_or_negated_or_window_edges() {
+    for text in ["P7:D((I<T&T<I)|T)","P7:D(!(I<T)&T<I)",
+        "P7:D(IN(1,3,I<T)&IN(4,7,T<I))","P7:D(I<T)U(T<I)"] {
+        assert!(!analyze(&filter(text)).execution_unsat,"{text}");
+    }
+    for text in ["P7:D((I<T<T)|(T<I<T))","P7:D(I<T&O<I&T<O)",
+        "{P7P7}:D(I[2]<T[2]<I[2])","P7:D(IN(1,4,I<T<I))"] {
+        assert!(analyze(&filter(text)).draw_unsat,"{text}");
+    }
+    assert!(!analyze(&filter("{P3:D(I<T<I);IOT}")).draw_unsat);
+    let u=analyze(&filter("P7:U(I<T&T<I)"));assert!(!u.draw_unsat);assert!(u.execution_unsat);
+}
+#[test]
+fn structure_and_canonical_text_roundtrip_without_expansion() {
+    for text in ["P4:D(I<T|!S)","P7:D(IN(1,3,T=1)&I<T)",
+        "{P7P7}:D(I[2]<T[2],I[2])","P4:U(!(I<T)|T=0)"] {
+        let n=filter(text);let f=tessembly_text::format(&n).unwrap();
+        assert_eq!(tessembly_text::format(&filter(&f)).unwrap(),f);
+        let d=tessembly_codec::Document{root:n,optional_extensions:vec![]};
+        let b=tessembly_codec::encode(&d).unwrap();
+        let back=tessembly_codec::decode(&b).unwrap();assert_eq!(back,d);
+        assert_eq!(tessembly_codec::encode(&back).unwrap(),b);
+        for k in 0..b.len() {assert!(tessembly_codec::decode(&b[..k]).is_err());}
+        let mut old=b.clone();old[5]=2;assert!(tessembly_codec::migrate_rfc2(&old).is_err());
+    }
+}
+#[test]
+fn advanced_filters_share_the_parser_without_named_argument_collisions() {
+    for relation in ["T=1 & I<T","IN(1,3,T)&!(I<T)","T[2]<I[2] | !T"] {
+        let source=format!("tessembly \"{PROFILE}\"; supply(\"P7P7\"); draw({relation});");
+        let d=tessembly_document::parse(&source).unwrap();
+        let text=d.to_text().unwrap();let back=tessembly_document::parse(&text).unwrap();
+        assert_eq!(back,d);
+        assert_eq!(tessembly_document::wire::decode(&tessembly_document::wire::encode(&d).unwrap()).unwrap(),d);
+        assert!(d.standard_pattern().is_ok());
+    }
+}
+#[test]
+fn named_ids_can_be_filtered_without_executing_a_source() {
+    let s=format!("tessembly \"{PROFILE}\"; config {{registry=[\"PENTO_P\"];}} supply(take(8,bag([\"PENTO_P\",\"I\"]))); draw(any(count(\"PENTO_P\",\">=\",2),within(1,3,present(\"I\"))));");
+    let d=tessembly_document::parse(&s).unwrap();
+    assert!(d.standard_pattern().is_err());
+    assert_eq!(tessembly_document::parse(&d.to_text().unwrap()).unwrap(),d);
+    assert_eq!(tessembly_document::wire::decode(&tessembly_document::wire::encode(&d).unwrap()).unwrap(),d);
+    let caps=d.requirements().unwrap();
+    for c in ["filters.logic.v1","filters.count.v1","filters.window.v1"] {assert!(caps.iter().any(|x|x==c));}
+}
+#[test]
+fn legacy_and_unapproved_syntax_are_not_reinterpreted() {
+    for text in ["P4:D(I<T|T)","P4:D(!T)","P4:D(T=1)","P4:D(IN(1,3,T))","P4:D(T[2])"] {
+        assert!(tessembly_text::parse(text,LEGACY_PROFILE).is_err());
+    }
+    for text in ["P4:D(I<T||S)","P4:D(T&&I)","P4:D(!I<T)","P4:D(!T=1)",
+        "P4:D(T[0])","P4:D(1-3:T)","P4:D([1:3](T))","P4:U(IN(1,2,T))","P4:U(T[2])"] {
+        assert!(tessembly_text::parse(text,PROFILE).is_err(),"{text}");
+    }
+    for name in ["qb","oqb","goal","dataset","query"] {
+        assert!(tessembly_document::parse(&format!("tessembly \"{PROFILE}\"; supply(\"P7\"); {name}(\"X\");")).is_err());
+    }
+}
+#[test]
+fn hidden_invalid_branches_are_not_masked_by_boolean_short_circuit() {
+    let s=format!("tessembly \"{PROFILE}\"; supply(\"P4\"); draw(any(T,present(\"UNKNOWN\"))); ");
+    assert!(tessembly_document::parse(&s).is_err());
+    let f=Filter::Any(vec![Filter::Present(Occurrence::first(Piece::T)),
+        Filter::In{start:1,end:7,condition:Box::new(Filter::Present(Occurrence::first(Piece::I)))}]);
+    assert_eq!(evaluate_filter_checked(&[Piece::T],&f).unwrap_err().code,"INVALID_FILTER_WINDOW");
+}
+#[test]
+fn typed_and_decoded_budget_limits_cover_nested_boolean_nodes() {
+    let one=Filter::Present(Occurrence::first(Piece::I));
+    let big=Filter::Any(vec![one;4096]);
+    let p=Predicate{kind:PredicateKind::Filter(big),span:Span::default()};
+    assert_eq!(matches_checked(&[Piece::I],&[p]).unwrap_err().code,"PREDICATE_LIMIT");
+    let deep=format!("P4:D({}T{})","!(".repeat(80),")".repeat(80));
+    assert!(tessembly_text::parse(&deep,PROFILE).is_err());
+    assert!(tessembly_text::parse(&format!("P4:D({})",vec!["T";4097].join("|")),PROFILE).is_err());
+    let bad=Filter::Count(Piece::T,CountOp::Eq,65535);
+    assert_eq!(evaluate_filter_checked(&[Piece::T],&bad).unwrap_err().code,"INVALID_COUNT");
+}
+#[test]
+fn decoded_filters_respect_document_wide_budget() {
+    let formula=(0..1200).map(|_|"!T").collect::<Vec<_>>().join("|");
+    let root=filter(&format!("P4:D({formula})"));
+    let mut d=tessembly_document::Document::empty();
+    d.source=Some(tessembly_document::Value::Call(tessembly_document::Call::new("concat",vec![
+        tessembly_document::Value::Pattern(Box::new(root.clone())),
+        tessembly_document::Value::Pattern(Box::new(root)),
+    ])));
+    assert_eq!(d.validate().unwrap_err().code,"PREDICATE_LIMIT");
+}
+#[test]
+fn repeated_word_oracle_tests_exact_truth_not_just_cardinality() {
+    let expressions=["I<T|!S","T=2 & I<T","IN(2,3,T)","I[2]<T[2]"];
+    let parsed=expressions.map(|c|filter(&format!("{{P4}}:D({c})")));
+    let mut checked=0;
+    for a in b"ITS" { for b in b"ITS" { for c in b"ITS" { for d in b"ITS" {
+        let bytes=[*a,*b,*c,*d];let q=bytes.map(|x|Piece::from_ascii(x).unwrap());
+        let first=|kind|bytes.iter().position(|b|*b==kind);
+        let earlier=first(b'I').is_some_and(|i|first(b'T').is_none_or(|j|i<j));
+        let second=|kind|bytes.iter().enumerate().filter(|(_,b)|**b==kind).nth(1).map(|(i,_)|i);
+        let expected=[earlier||!bytes.contains(&b'S'),bytes.iter().filter(|x|**x==b'T').count()==2&&earlier,
+            bytes[1..3].contains(&b'T'),second(b'I').is_some_and(|i|second(b'T').is_none_or(|j|i<j))];
+        for (n,want) in parsed.iter().zip(expected) {assert_eq!(matches_checked(&q,n.constraints.draw.as_ref().unwrap()).unwrap(),want);}
+        checked+=1;
+    }}}}
+    assert_eq!(checked,81);
+}
