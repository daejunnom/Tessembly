+//! Shared bounded condition parser. Compact and advanced declarations use one grammar.
+use std::collections::BTreeSet;
+use tessembly_core::{CountOp, Error, Filter, Occurrence, Result, Span, LEGACY_PROFILE,
+    MAX_DEPTH, MAX_DRAWS, MAX_INPUT, MAX_PREDICATES};
+
+pub type SpannedFilter = (Filter<String>, Span);
+
+/// Starts immediately after an opening parenthesis; consumes the matching ')'.
+/// `used` is shared by all blocks in the containing source/document.
+pub fn parse_conditions(text: &str, start: usize, profile: &str, named: bool,
+    used: &mut usize) -> Result<(Vec<SpannedFilter>, usize)> {
+    if text.len() > MAX_INPUT || !text.is_char_boundary(start) || start > text.len() {
+        return Err(Error::new("INPUT_LIMIT"));
+    }
+    let mut p = Parser { text, at:start, named, legacy:profile==LEGACY_PROFILE, used };
+    let mut out = Vec::new();
+    loop {
+        p.ws();
+        let start = p.at;
+        let expr = p.or(0)?;
+        out.push((expr, Span { start, end:p.at }));
+        if !p.eat(b',') { break; }
+    }
+    p.expect(b')')?;
+    Ok((out,p.at))
+}
+struct Parser<'a,'b> { text:&'a str, at:usize, named:bool, legacy:bool, used:&'b mut usize }
+impl Parser<'_, '_> {
+    fn err(&self, code:&'static str)->Error { Error::at(code,self.at,(self.at+1).min(self.text.len())) }
+    fn ws(&mut self) {
+        loop {
+            while self.text.as_bytes().get(self.at).is_some_and(u8::is_ascii_whitespace) { self.at+=1; }
+            if self.named && self.text.as_bytes().get(self.at..self.at+2)==Some(b"//") {
+                while self.text.as_bytes().get(self.at).is_some_and(|c|*c!=b'\n') { self.at+=1; }
+            } else { break; }
+        }
+    }
+    fn peek(&mut self)->Option<u8> { self.ws(); self.text.as_bytes().get(self.at).copied() }
+    fn eat(&mut self,c:u8)->bool { if self.peek()==Some(c) {self.at+=1;true} else {false} }
+    fn expect(&mut self,c:u8)->Result<()> { if self.eat(c) {Ok(())} else {Err(self.err("EXPECTED_FILTER_TOKEN"))} }
+    fn fresh(&mut self,f:Filter<String>)->Result<Filter<String>> {
+        if *self.used >= MAX_PREDICATES {return Err(self.err("PREDICATE_LIMIT"));}
+        *self.used+=1; Ok(f)
+    }
+    fn modern(&self)->Result<()> {
+        if self.legacy {Err(self.err("UNSUPPORTED_LEGACY_FILTER"))} else {Ok(())}
+    }
+    fn depth(&self,n:usize)->Result<()> {
+        if n>MAX_DEPTH/3 {Err(self.err("FILTER_DEPTH_LIMIT"))} else {Ok(())}
+    }
+    fn combine(&mut self, mut xs:Vec<Filter<String>>, any:bool)->Result<Filter<String>> {
+        if xs.is_empty() {return Err(self.err("EMPTY_CONSTRAINT"));}
+        if xs.len()==1 {Ok(xs.remove(0))} else {self.fresh(if any {Filter::Any(xs)} else {Filter::All(xs)})}
+    }
+    fn or(&mut self,d:usize)->Result<Filter<String>> {
+        self.depth(d)?;
+        let mut xs=vec![self.and(d)?];
+        while self.eat(b'|') {self.modern()?; xs.push(self.and(d)?);}
+        self.combine(xs,true)
+    }
+    fn and(&mut self,d:usize)->Result<Filter<String>> {
+        let mut xs=vec![self.unary(d)?];
+        while self.eat(b'&') {self.modern()?; xs.push(self.unary(d)?);}
+        self.combine(xs,false)
+    }
+    fn unary(&mut self,d:usize)->Result<Filter<String>> {
+        self.depth(d)?;
+        if self.eat(b'!') {
+            self.modern()?;
+            let grouped=matches!(self.peek(),Some(b'(' | b'!'));
+            let x=self.unary(d+1)?;
+            fn presence(f:&Filter<String>)->bool {
+                match f {Filter::Present(_)=>true,Filter::All(xs)=>xs.iter().all(presence),_=>false}
+            }
+            if !grouped && !presence(&x) {return Err(self.err("NEGATION_REQUIRES_PARENTHESES"));}
+            return self.fresh(Filter::Not(Box::new(x)));
+        }
+        if self.eat(b'(') {
+            self.modern()?;
+            let x=self.or(d+1)?;
+            self.expect(b')')?;
+            return Ok(x);
+        }
+        self.atom(d)
+    }
+    fn function(&mut self)->Option<String> {
+        self.ws();
+        let start=self.at;
+        let mut end=start;
+        while self.text.as_bytes().get(end).is_some_and(|b|b.is_ascii_alphabetic()||*b==b'_') {end+=1;}
+        let mut after=end;
+        while self.text.as_bytes().get(after).is_some_and(u8::is_ascii_whitespace) {after+=1;}
+        if end>start && self.text.as_bytes().get(after)==Some(&b'(') {
+            Some(self.text[start..end].to_owned())
+        } else {None}
+    }
+    fn number(&mut self)->Result<u16> {
+        self.ws();
+        let start=self.at;
+        let mut n=0u16;
+        while let Some(c @ b'0'..=b'9')=self.text.as_bytes().get(self.at).copied() {
+            self.at+=1;
+            n=n.checked_mul(10).and_then(|n|n.checked_add(u16::from(c-b'0')))
+                .ok_or_else(||self.err("COUNT_OVERFLOW"))?;
+        }
+        if self.at==start {return Err(self.err("EXPECTED_COUNT"));}
+        if usize::from(n)>MAX_DRAWS {return Err(self.err("INVALID_COUNT"));}
+        Ok(n)
+    }
+    fn string(&mut self)->Result<String> {
+        self.expect(b'"')?;
+        let mut s=String::new();
+        loop {
+            let c=self.text[self.at..].chars().next().ok_or_else(||self.err("UNCLOSED_STRING"))?;
+            self.at+=c.len_utf8();
+            match c {
+                '"'=>return Ok(s),
+                '\\'=>{
+                    let e=self.text[self.at..].chars().next().ok_or_else(||self.err("UNCLOSED_STRING"))?;
+                    self.at+=e.len_utf8();
+                    s.push(match e {'"'=>'"','\\'=>'\\','n'=>'\n','r'=>'\r','t'=>'\t',_=>return Err(self.err("INVALID_ESCAPE"))});
+                }
+                x if x.is_control()=>return Err(self.err("CONTROL_IN_STRING")),
+                _=>s.push(c),
+            }
+        }
+    }
+    fn selector(&mut self)->Result<Occurrence<String>> {
+        if self.named && self.function().as_deref()==Some("nth") {
+            self.modern()?; self.at+=3; self.expect(b'(')?;
+            let piece=self.string()?; self.expect(b',')?; let nth=self.number()?; self.expect(b')')?;
+            if nth==0 {return Err(self.err("INVALID_OCCURRENCE"));}
+            return Ok(Occurrence {piece,nth});
+        }
+        let piece=if self.named && self.peek()==Some(b'"') {self.string()?}
+        else {
+            let c=self.peek().ok_or_else(||self.err("EXPECTED_PIECE_GROUP"))?;
+            if !b"IOTSZJL".contains(&c) {return Err(self.err("EXPECTED_PIECE_GROUP"));}
+            self.at+=1; (c as char).to_string()
+        };
+        let nth=if self.eat(b'[') {
+            self.modern()?; let n=self.number()?; self.expect(b']')?;
+            if n==0 {return Err(self.err("INVALID_OCCURRENCE"));} n
+        } else {1};
+        Ok(Occurrence {piece,nth})
+    }
+    fn group(&mut self)->Result<Vec<Occurrence<String>>> {
+        let mut xs=BTreeSet::new();
+        xs.insert(self.selector()?);
+        loop {
+            let has=self.peek().is_some_and(|b|b"IOTSZJL".contains(&b));
+            if !has || self.function().is_some() {break;}
+            xs.insert(self.selector()?);
+            if xs.len()>MAX_PREDICATES {return Err(self.err("PREDICATE_LIMIT"));}
+        }
+        // Existing compact canonical order is I,O,T,S,Z,J,L, not alphabetical.
+        let mut xs:Vec<_>=xs.into_iter().collect();
+        xs.sort_by_key(|s| (b"IOTSZJL".iter().position(|b|s.piece.as_bytes()==[*b]).unwrap_or(7),s.nth,s.piece.clone()));
+        Ok(xs)
+    }
+    fn atom(&mut self,d:usize)->Result<Filter<String>> {
+        if let Some(name)=self.function() {
+            if name=="IN" || (self.named && name=="within") {
+                self.modern()?; self.at+=name.len(); self.expect(b'(')?;
+                let start=self.number()?; self.expect(b',')?; let end=self.number()?; self.expect(b',')?;
+                let mut xs=vec![self.or(d+1)?];
+                while self.eat(b',') {xs.push(self.or(d+1)?);}
+                self.expect(b')')?;
+                if start==0 || start>end {return Err(self.err("INVALID_FILTER_WINDOW"));}
+                let condition=Box::new(self.combine(xs,false)?);
+                return self.fresh(Filter::In {start,end,condition});
+            }
+            if self.named && ["all","any","not"].contains(&name.as_str()) {
+                if name!="all" {self.modern()?;}
+                self.at+=name.len(); self.expect(b'(')?;
+                let mut xs=vec![self.or(d+1)?];
+                while self.eat(b',') {xs.push(self.or(d+1)?);}
+                self.expect(b')')?;
+                if name=="not" {
+                    if xs.len()!=1 {return Err(self.err("ARGUMENT_COUNT"));}
+                    return self.fresh(Filter::Not(Box::new(xs.remove(0))));
+                }
+                return self.combine(xs,name=="any");
+            }
+            if self.named && ["before","present","count"].contains(&name.as_str()) {
+                self.at+=name.len(); self.expect(b'(')?;
+                let a=self.selector()?;
+                let f=match name.as_str() {
+                    "present"=>Filter::Present(a),
+                    "before"=>{
+                        self.expect(b',')?; let b=self.selector()?;
+                        Filter::Before(a,b)
+                    }
+                    _=>{
+                        self.modern()?; self.expect(b',')?; let op=self.string()?;
+                        self.expect(b',')?; let n=self.number()?;
+                        if a.nth!=1 {return Err(self.err("COUNT_REQUIRES_KIND"));}
+                        let op=match op.as_str() {"="=>CountOp::Eq,"!="=>CountOp::Ne,"<"=>CountOp::Lt,
+                            "<="=>CountOp::Le,">"=>CountOp::Gt,">="=>CountOp::Ge,_=>return Err(self.err("INVALID_COUNT_OPERATOR"))};
+                        Filter::Count(a.piece,op,n)
+                    }
+                };
+                self.expect(b')')?; return self.fresh(f);
+            }
+            if !(self.named && name=="nth") {return Err(self.err("UNKNOWN_FILTER_FUNCTION"));}
+        }
+        let mut left=self.group()?;
+        let mut comparisons=Vec::new();
+        while let Some(op @ (b'<'|b'>'|b'='|b'!'))=self.peek() {
+            self.at+=1;
+            let eq=self.eat(b'=');
+            if op==b'!' && !eq {return Err(self.err("INVALID_COUNT_OPERATOR"));}
+            if op==b'=' && eq {return Err(self.err("INVALID_COUNT_OPERATOR"));}
+            let numeric=self.peek().is_some_and(|b|b.is_ascii_digit());
+            if numeric {
+                self.modern()?;
+                if left.len()!=1 || left[0].nth!=1 || !comparisons.is_empty() {return Err(self.err("COUNT_REQUIRES_KIND"));}
+                let n=self.number()?;
+                let op=match (op,eq) {(b'=',false)=>CountOp::Eq,(b'!',true)=>CountOp::Ne,
+                    (b'<',false)=>CountOp::Lt,(b'<',true)=>CountOp::Le,(b'>',false)=>CountOp::Gt,
+                    (b'>',true)=>CountOp::Ge,_=>return Err(self.err("INVALID_COUNT_OPERATOR"))};
+                return self.fresh(Filter::Count(left.remove(0).piece,op,n));
+            }
+            if eq || ![b'<',b'>'].contains(&op) {return Err(self.err("EXPECTED_COUNT"));}
+            let right=self.group()?;
+            for a in &left { for b in &right {
+                let (a,b)=if (op==b'<')!=self.legacy {(a,b)} else {(b,a)};
+                comparisons.push(self.fresh(Filter::Before(a.clone(),b.clone()))?);
+            }}
+            left=right;
+        }
+        if comparisons.is_empty() {
+            for a in left {comparisons.push(self.fresh(Filter::Present(a))?);}
+        }
+        self.combine(comparisons,false)
+    }
+}
+
+/// Bounded parser output is converted to old atom nodes where possible.
+pub fn standard_predicates(f: Filter<String>, span: Span,
+    out: &mut Vec<tessembly_core::Predicate>) -> Result<()> {
+    use tessembly_core::{Piece, Predicate, PredicateKind};
+    if let Filter::All(xs)=f {
+        for x in xs {standard_predicates(x,span,out)?;}
+        return Ok(());
+    }
+    let f=f.try_map(&mut |id:&String| {
+        if id.len()!=1 {return Err(Error::new("COMPACT_RELATION_REQUIRES_STANDARD_IDS"));}
+        Piece::from_ascii(id.as_bytes()[0])
+    })?;
+    let kind=match f {
+        Filter::Present(s) if s.nth==1=>PredicateKind::Present(s.piece),
+        Filter::Before(a,b) if a.nth==1 && b.nth==1=>PredicateKind::Before(a.piece,b.piece),
+        other=>PredicateKind::Filter(other),
+    };
+    out.push(Predicate {kind,span}); Ok(())
+}
+
+/// Structural rendering: parenthesized boolean trees, never exponential expansion.
+pub fn render<K>(f:&Filter<K>, named:bool, id:&impl Fn(&K)->String)->String {
+    fn sel<K>(s:&Occurrence<K>,named:bool,id:&impl Fn(&K)->String)->String {
+        let k=id(&s.piece);
+        if s.nth==1 {k} else if named {format!("nth({k},{})",s.nth)} else {format!("{k}[{}]",s.nth)}
+    }
+    match f {
+        Filter::Present(s) => if named {format!("present({})",sel(s,true,id))} else {sel(s,false,id)},
+        Filter::Before(a,b)=> if named {format!("before({},{})",sel(a,true,id),sel(b,true,id))}
+            else {format!("{}<{}",sel(a,false,id),sel(b,false,id))},
+        Filter::Count(k,op,n)=>if named {format!("count({},\"{}\",{n})",id(k),op.symbol())}
+            else {format!("{}{}{n}",id(k),op.symbol())},
+        Filter::All(xs) | Filter::Any(xs)=>{
+            let and=matches!(f,Filter::All(_));
+            let children=xs.iter().map(|x|render(x,named,id)).collect::<Vec<_>>();
+            if named {format!("{}({})",if and {"all"} else {"any"},children.join(","))}
+            else {format!("({})",children.join(if and {"&"} else {"|"}))}
+        }
+        Filter::Not(x)=>if named {format!("not({})",render(x,true,id))}
+            else {format!("!({})",render(x,false,id))},
+        Filter::In{start,end,condition}=>format!("{}({start},{end},{})",if named {"within"} else {"IN"},render(condition,named,id)),
+    }
+}
